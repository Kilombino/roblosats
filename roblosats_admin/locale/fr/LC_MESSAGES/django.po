msgctxt "roblosats-admin"
msgid "The buyer %(buyer)s is credited %(total)s sats as a reward (their bond of %(buyer_bond)s + %(trade)s from the trade). They withdraw it from the app."
msgstr "L'acheteur %(buyer)s est crédité de %(total)s sats en récompense (sa caution de %(buyer_bond)s + %(trade)s de l'échange). Il les retire depuis l'application."

msgctxt "roblosats-admin"
msgid "The seller %(seller)s gets nothing back: they lose their bond (%(seller_bond)s) and their escrow (%(escrow)s)."
msgstr "Le vendeur %(seller)s ne récupère rien : il perd sa caution (%(seller_bond)s) et son séquestre (%(escrow)s)."

msgctxt "roblosats-admin"
msgid "The seller %(seller)s is credited %(total)s sats as a reward (their bond of %(seller_bond)s + their escrow of %(escrow)s). They withdraw it from the app."
msgstr "Le vendeur %(seller)s est crédité de %(total)s sats en récompense (sa caution de %(seller_bond)s + son séquestre de %(escrow)s). Il les retire depuis l'application."

msgctxt "roblosats-admin"
msgid "The buyer %(buyer)s gets nothing and loses their bond (%(buyer_bond)s)."
msgstr "L'acheteur %(buyer)s ne reçoit rien et perd sa caution (%(buyer_bond)s)."

msgctxt "roblosats-admin"
msgid "The order ends as collaboratively cancelled."
msgstr "L'ordre se termine comme annulé d'un commun accord."

msgctxt "roblosats-admin"
msgid "%(t)s left"
msgstr "il reste %(t)s"

