msgid "Order %(id)s could not be resolved. Response: %(detail)s"
msgstr "L'ordre %(id)s n'a pas pu être tranché. Réponse : %(detail)s"

msgctxt "roblosats-admin"
msgid "The buyer's invoice has already expired: the payment will probably fail and you will have to ask them for a new one."
msgstr "La facture de l'acheteur a déjà expiré : le paiement échouera probablement et il faudra lui en demander une nouvelle."

msgctxt "roblosats-admin"
msgid "Both bonds are credited back as rewards: %(buyer_bond)s to the buyer and %(seller_bond)s to the seller %(seller)s."
msgstr "Les deux cautions sont recréditées en récompense : %(buyer_bond)s à l'acheteur et %(seller_bond)s au vendeur %(seller)s."

msgctxt "roblosats-admin"
msgid "The message has %(n)s characters; the limit is %(max)s. Nothing was sent."
msgstr "Le message fait %(n)s caractères ; la limite est de %(max)s. Rien n'a été envoyé."

msgctxt "roblosats-admin"
msgid "There is nobody to send it to."
msgstr "Il n'y a personne à qui l'envoyer."

msgctxt "roblosats-admin"
msgid "The buyer %(buyer)s is paid %(trade)s sats on-chain, to the address they gave."
msgstr "L'acheteur %(buyer)s reçoit %(trade)s sats on-chain, à l'adresse qu'il a fournie."

msgctxt "roblosats-admin"
msgid "The buyer %(buyer)s is paid %(trade)s sats right now over Lightning, to the invoice they gave."
msgstr "L'acheteur %(buyer)s reçoit immédiatement %(trade)s sats via Lightning, sur la facture qu'il a fournie."

