msgid "Order %(id)s is public in the order book again"
msgstr "Order %(id)s ist wieder im Orderbuch öffentlich"

msgctxt "roblosats-admin"
msgid "Order %(id)s was taken: the taker's bond is locked"
msgstr "Order %(id)s wurde angenommen: die Kaution des Takers ist gesperrt"

msgctxt "roblosats-admin"
msgid "Order %(id)s: escrow and buyer's invoice are in, the fiat exchange starts"
msgstr "Order %(id)s: Treuhand und Rechnung des Käufers sind da, der Fiat-Tausch beginnt"

msgctxt "roblosats-admin"
msgid "Order %(id)s finished successfully"
msgstr "Order %(id)s erfolgreich abgeschlossen"

msgctxt "roblosats-admin"
msgid "Order %(id)s: %(status)s"
msgstr "Order %(id)s: %(status)s"

