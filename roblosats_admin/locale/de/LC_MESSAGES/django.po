msgstr "Speichern"

msgctxt "roblosats-admin"
msgid "Try it"
msgstr "Ausprobieren"

msgctxt "roblosats-admin"
msgid "Sends a message with the saved settings. Save first if you changed something."
msgstr "Sendet eine Nachricht mit den gespeicherten Einstellungen. Speichere zuerst, wenn du etwas geändert hast."

