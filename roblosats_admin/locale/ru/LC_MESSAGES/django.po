msgstr "истёк"

msgctxt "roblosats-admin"
msgid "valid invoice"
msgstr "действительный инвойс"

msgctxt "roblosats-admin"
msgid "payment in flight"
msgstr "платёж в пути"

msgctxt "roblosats-admin"
msgid "paid"
msgstr "оплачен"

msgctxt "roblosats-admin"
msgid "payment failed"
msgstr "платёж не прошёл"

msgctxt "roblosats-admin"
msgid "Buyer wins"
msgstr "Побеждает покупатель"

msgctxt "roblosats-admin"
msgid "Seller wins"
msgstr "Побеждает продавец"

msgctxt "roblosats-admin"
msgid "Return everything"
msgstr "Вернуть всё"

msgctxt "roblosats-admin"
msgid "Trade completed (pay the buyer)"
msgstr "Сделка состоялась (выплатить покупателю)"

msgctxt "roblosats-admin"
msgid "Open"
msgstr "Открытые"

msgctxt "roblosats-admin"
msgid "Waiting for your decision"
msgstr "Ждут вашего решения"

msgctxt "roblosats-admin"
msgid "History"
msgstr "История"

msgctxt "roblosats-admin"
msgid "Disputes"
msgstr "Споры"

