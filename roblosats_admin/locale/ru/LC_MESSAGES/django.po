msgstr "Ожидается эскроу продавца"

msgctxt "roblosats-admin"
msgid "Waiting for the buyer's invoice"
msgstr "Ожидается инвойс покупателя"

msgctxt "roblosats-admin"
msgid "In the chat: the buyer has to pay"
msgstr "В чате: покупатель должен заплатить"

