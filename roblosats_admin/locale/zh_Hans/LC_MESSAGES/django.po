msgid "a bond is missing"
msgstr "缺少保证金"

msgctxt "roblosats-admin"
msgid "Dispute of order %(id)s"
msgstr "订单 %(id)s 的争议"

msgctxt "roblosats-admin"
msgid "BUY"
msgstr "买入"

msgctxt "roblosats-admin"
msgid "SELL"
msgstr "卖出"

msgctxt "roblosats-admin"
msgid "the maker buys sats"
msgstr "挂单方买入聪"

msgctxt "roblosats-admin"
msgid "the maker sells sats"
msgstr "挂单方卖出聪"

msgctxt "roblosats-admin"
msgid "Unknown action."
msgstr "未知操作。"

