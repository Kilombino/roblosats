msgstr "全部退还"

msgctxt "roblosats-admin"
msgid "Trade completed (pay the buyer)"
msgstr "交易完成（向买方付款）"

msgctxt "roblosats-admin"
msgid "%(m)s min"
msgstr "%(m)s 分钟"

msgctxt "roblosats-admin"
msgid "%(d)s d %(h)s h"
msgstr "%(d)s 天 %(h)s 小时"

