msgstr "你还没有以协调者身份给他们发过消息。"

msgctxt "roblosats-admin"
msgid "Write to them"
msgstr "给他们写消息"

msgctxt "roblosats-admin"
msgid "Prefix added to every message"
msgstr "每条消息都会加上的前缀"

msgctxt "roblosats-admin"
