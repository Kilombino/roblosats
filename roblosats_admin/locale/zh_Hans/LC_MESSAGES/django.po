msgstr "写给买方"

msgctxt "roblosats-admin"
msgid "Write to the seller"
msgstr "写给卖方"

msgctxt "roblosats-admin"
msgid "Write to both"
msgstr "写给双方"

msgctxt "roblosats-admin"
msgid "Resolve the dispute"
msgstr "裁决争议"

msgctxt "roblosats-admin"
msgid "Are you sure?"
msgstr "确定吗？"

msgctxt "roblosats-admin"
msgid "This cannot be undone."
msgstr "此操作无法撤销。"

msgctxt "roblosats-admin"
msgid "Yes, resolve it this way"
msgstr "是，按此裁决"

msgctxt "roblosats-admin"
msgid "Cancel"
msgstr "取消"

msgctxt "roblosats-admin"
msgid "Not possible"
msgstr "无法执行"

msgctxt "roblosats-admin"
msgid "Back"
msgstr "返回"

msgctxt "roblosats-admin"
msgid "This order is no longer in dispute; there is nothing to resolve."
msgstr "此订单已不在争议中，无需裁决。"

msgctxt "roblosats-admin"
msgid "Not available"
msgstr "不可用"

msgctxt "roblosats-admin"
msgid "Nothing happens until you confirm, and the confirmation shows who receives how many sats. Rewards are credited to the robot, which withdraws them from the app."
msgstr "在你确认之前不会执行任何操作，确认页会显示谁收到多少聪。奖励记入机器人账户，由其在应用中提取。"

msgctxt "roblosats-admin"
msgid "Your user can see this dispute but has no permission to change orders."
msgstr "你的账户可以查看此争议，但没有修改订单的权限。"

msgctxt "roblosats-admin"
msgid "Technical details"
msgstr "技术细节"

msgctxt "roblosats-admin"
msgid "Open the full order record (all fields)"
msgstr "打开完整的订单记录（全部字段）"

msgctxt "roblosats-admin"
msgid "Locked funds"
msgstr "锁定资金"

msgctxt "roblosats-admin"
msgid "Item"
msgstr "项目"

msgctxt "roblosats-admin"
msgid "Sats"
msgstr "聪"

msgctxt "roblosats-admin"
msgid "Status"
msgstr "状态"

msgctxt "roblosats-admin"
msgid "Expires"
msgstr "到期"

msgctxt "roblosats-admin"
msgid "Buyer's bond"
msgstr "买方保证金"

msgctxt "roblosats-admin"
msgid "Seller's bond"
msgstr "卖方保证金"

msgctxt "roblosats-admin"
msgid "Seller's escrow"
msgstr "卖方托管资金"

msgctxt "roblosats-admin"
msgid "Buyer's payout invoice"
msgstr "买方收款发票"

msgctxt "roblosats-admin"
msgid "Buyer's on-chain payout"
msgstr "买方链上收款"

msgctxt "roblosats-admin"
msgid "Order log"
msgstr "订单日志"

msgctxt "roblosats-admin"
msgid "No log saved."
msgstr "没有保存的日志。"

msgctxt "roblosats-admin"
msgid "Up to %(max)s characters. It arrives as an app notification, a Nostr DM and a Telegram message if they use them. It is sent as written: write it in the reader's language."
msgstr "最多 %(max)s 个字符。对方会收到应用内通知、Nostr 私信，以及 Telegram 消息（如有使用）。消息原样发送：请用对方的语言书写。"

msgctxt "roblosats-admin"
msgid "Open disputes"
msgstr "进行中的争议"

msgctxt "roblosats-admin"
msgid "statement submitted"
msgstr "已提交陈述"

msgctxt "roblosats-admin"
msgid "no statement"
msgstr "无陈述"

msgctxt "roblosats-admin"
msgid "There are no open disputes."
msgstr "目前没有进行中的争议。"

msgctxt "roblosats-admin"
msgid "Past disputes"
msgstr "历史争议"

msgctxt "roblosats-admin"
msgid "Trade"
msgstr "交易"

msgctxt "roblosats-admin"
msgid "Buyer / seller"
msgstr "买方 / 卖方"

msgctxt "roblosats-admin"
msgid "Outcome"
msgstr "结果"

msgctxt "roblosats-admin"
msgid "Created"
msgstr "创建时间"

msgctxt "roblosats-admin"
msgid "None yet."
msgstr "暂无。"

msgctxt "roblosats-admin"
msgid "Orders"
msgstr "订单"

msgctxt "roblosats-admin"
msgid "Send to"
msgstr "发送给"

msgctxt "roblosats-admin"
msgid "both"
msgstr "双方"

msgctxt "roblosats-admin"
msgid "Send"
msgstr "发送"
