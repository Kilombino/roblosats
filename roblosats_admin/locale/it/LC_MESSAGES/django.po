msgstr "Fattura di pagamento dell'acquirente"

msgctxt "roblosats-admin"
msgid "Buyer's on-chain payout"
msgstr "Pagamento on-chain dell'acquirente"

msgctxt "roblosats-admin"
msgid "Order log"
msgstr "Registro dell'ordine"

msgctxt "roblosats-admin"
msgid "No log saved."
msgstr "Nessun registro salvato."

msgctxt "roblosats-admin"
msgid "Up to %(max)s characters. It arrives as an app notification, a Nostr DM and a Telegram message if they use them. It is sent as written: write it in the reader's language."
msgstr "Fino a %(max)s caratteri. Arriva come notifica nell'app, DM Nostr e messaggio Telegram se li usano. Viene inviato così com'è: scrivilo nella lingua di chi lo leggerà."

msgctxt "roblosats-admin"
msgid "Waiting for your decision (both statements submitted)"
msgstr "In attesa della tua decisione (entrambe le dichiarazioni inviate)"

msgctxt "roblosats-admin"
