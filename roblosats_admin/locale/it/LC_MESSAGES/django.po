msgctxt "roblosats-admin"
msgid "The buyer %(buyer)s is credited %(total)s sats as a reward (their bond of %(buyer_bond)s + %(trade)s from the trade). They withdraw it from the app."
msgstr "All'acquirente %(buyer)s vengono accreditati %(total)s sats come ricompensa (la sua cauzione di %(buyer_bond)s + %(trade)s dello scambio). Li preleva dall'app."

msgctxt "roblosats-admin"
msgid "The seller %(seller)s gets nothing back: they lose their bond (%(seller_bond)s) and their escrow (%(escrow)s)."
msgstr "Il venditore %(seller)s non recupera nulla: perde la sua cauzione (%(seller_bond)s) e il suo deposito (%(escrow)s)."

msgctxt "roblosats-admin"
msgid "The seller %(seller)s is credited %(total)s sats as a reward (their bond of %(seller_bond)s + their escrow of %(escrow)s). They withdraw it from the app."
msgstr "Al venditore %(seller)s vengono accreditati %(total)s sats come ricompensa (la sua cauzione di %(seller_bond)s + il suo deposito di %(escrow)s). Li preleva dall'app."

msgctxt "roblosats-admin"
msgid "The buyer %(buyer)s gets nothing and loses their bond (%(buyer_bond)s)."
msgstr "L'acquirente %(buyer)s non riceve nulla e perde la sua cauzione (%(buyer_bond)s)."

msgctxt "roblosats-admin"
msgid "The order ends as collaboratively cancelled."
msgstr "L'ordine si chiude come annullato di comune accordo."

msgctxt "roblosats-admin"
msgid "%(t)s left"
msgstr "mancano %(t)s"

msgctxt "roblosats-admin"
