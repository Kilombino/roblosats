msgctxt "roblosats-admin"
msgid "Not possible"
msgstr "Non possibile"

msgctxt "roblosats-admin"
msgid "Back"
msgstr "Indietro"

msgctxt "roblosats-admin"
msgid "This order is no longer in dispute; there is nothing to resolve."
msgstr "Questo ordine non è più in disputa; non c'è nulla da risolvere."

msgctxt "roblosats-admin"
msgid "Not available"
msgstr "Non disponibile"

msgctxt "roblosats-admin"
msgid "Nothing happens until you confirm, and the confirmation shows who receives how many sats. Rewards are credited to the robot, which withdraws them from the app."
msgstr "Non succede nulla finché non confermi, e la conferma mostra chi riceve quanti sats. Le ricompense vengono accreditate al robot, che le preleva dall'app."

msgctxt "roblosats-admin"
msgid "Your user can see this dispute but has no permission to change orders."
msgstr "Il tuo utente può vedere questa disputa ma non ha il permesso di modificare gli ordini."

msgctxt "roblosats-admin"
msgid "Technical details"
msgstr "Dettagli tecnici"

msgctxt "roblosats-admin"
msgid "Open the full order record (all fields)"
msgstr "Apri la scheda completa dell'ordine (tutti i campi)"

msgctxt "roblosats-admin"
