msgid "opened automatically (the chat deadline expired)"
msgstr "aperta automaticamente (scaduto il termine della chat)"

msgctxt "roblosats-admin"
msgid "unknown"
msgstr "sconosciuto"

msgctxt "roblosats-admin"
msgid "the buyer never submitted a payout invoice or address"
msgstr "l'acquirente non ha mai fornito una fattura o un indirizzo di pagamento"

msgctxt "roblosats-admin"
msgid "Unknown decision"
msgstr "Decisione sconosciuta"

