msgctxt "roblosats-admin"
msgid "Resolve the dispute"
msgstr "Risolvere la disputa"

msgctxt "roblosats-admin"
msgid "Are you sure?"
msgstr "Sei sicuro?"

msgctxt "roblosats-admin"
msgid "This cannot be undone."
msgstr "Questa azione non si può annullare."

msgctxt "roblosats-admin"
msgid "Yes, resolve it this way"
msgstr "Sì, risolvi così"

msgctxt "roblosats-admin"
msgid "Cancel"
