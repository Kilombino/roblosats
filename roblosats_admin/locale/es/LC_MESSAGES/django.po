msgctxt "roblosats-admin"
msgid "The buyer %(buyer)s is credited %(total)s sats as a reward (their bond of %(buyer_bond)s + %(trade)s from the trade). They withdraw it from the app."
msgstr "Al comprador %(buyer)s se le abonan %(total)s sats como recompensa (su fianza de %(buyer_bond)s + %(trade)s de la operación). Los retira él desde la app."

msgctxt "roblosats-admin"
msgid "The seller %(seller)s gets nothing back: they lose their bond (%(seller_bond)s) and their escrow (%(escrow)s)."
msgstr "El vendedor %(seller)s no recupera nada: pierde su fianza (%(seller_bond)s) y su depósito (%(escrow)s)."

msgctxt "roblosats-admin"
msgid "The seller %(seller)s is credited %(total)s sats as a reward (their bond of %(seller_bond)s + their escrow of %(escrow)s). They withdraw it from the app."
msgstr "Al vendedor %(seller)s se le abonan %(total)s sats como recompensa (su fianza de %(seller_bond)s + su depósito de %(escrow)s). Los retira él desde la app."

msgctxt "roblosats-admin"
msgid "The buyer %(buyer)s gets nothing and loses their bond (%(buyer_bond)s)."
msgstr "El comprador %(buyer)s no recibe nada y pierde su fianza (%(buyer_bond)s)."

msgctxt "roblosats-admin"
msgid "The order ends as collaboratively cancelled."
msgstr "La orden queda como cancelada de mutuo acuerdo."

msgctxt "roblosats-admin"
msgid "%(t)s left"
msgstr "quedan %(t)s"

msgctxt "roblosats-admin"
