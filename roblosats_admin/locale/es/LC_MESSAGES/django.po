msgctxt "roblosats-admin"
msgid "Order %(id)s: escrow and buyer's invoice are in, the fiat exchange starts"
msgstr "Orden %(id)s: el depósito y la factura del comprador ya están, empieza el intercambio fiat"

msgctxt "roblosats-admin"
msgid "Order %(id)s finished successfully"
msgstr "La orden %(id)s se ha completado con éxito"

msgctxt "roblosats-admin"
msgid "Order %(id)s: %(status)s"
msgstr "Orden %(id)s: %(status)s"

msgctxt "roblosats-admin"
msgid "Dispute opened on order %(id)s"
msgstr "Se ha abierto una disputa en la orden %(id)s"

msgctxt "roblosats-admin"
msgid "New chat message from %(who)s on disputed order %(id)s"
msgstr "Nuevo mensaje de chat de %(who)s en la orden en disputa %(id)s"

msgctxt "roblosats-admin"
msgid "You wrote to %(names)s on order %(id)s"
msgstr "Has escrito a %(names)s en la orden %(id)s"

msgctxt "roblosats-admin"
msgid "Test message: the coordinator's alerts reach this chat."
msgstr "Mensaje de prueba: los avisos del coordinador llegan a este chat."

msgctxt "roblosats-admin"
msgid "The bot token does not look like a Telegram token."
msgstr "El token no parece un token de bot de Telegram."

msgctxt "roblosats-admin"
msgid "The chat id must be a number (groups start with -) or a @channel name."
msgstr "El id del chat tiene que ser un número (los grupos empiezan por -) o un @canal."

msgctxt "roblosats-admin"
msgid "The panel address must look like https://host or http://host:port, with nothing after it."
msgstr "La dirección del panel tiene que ser como https://host o http://host:puerto, sin nada detrás."

msgctxt "roblosats-admin"
msgid "Telegram alerts saved."
msgstr "Avisos por Telegram guardados."

msgctxt "roblosats-admin"
msgid "Save a bot token and a chat id first: there is nowhere to send it."
msgstr "Guarda antes un token y un id de chat: no hay a dónde enviarlo."

msgctxt "roblosats-admin"
msgid "Test message sent. Check the Telegram chat."
msgstr "Mensaje de prueba enviado. Mira el chat de Telegram."

msgctxt "roblosats-admin"
msgid "Telegram did not accept the message: %(why)s"
msgstr "Telegram no ha aceptado el mensaje: %(why)s"

msgctxt "roblosats-admin"
msgid "nobody took it"
msgstr "nadie la tomó"

msgctxt "roblosats-admin"
msgid "the maker's bond was not locked"
msgstr "no se bloqueó la fianza del creador"

msgctxt "roblosats-admin"
msgid "the seller's escrow was not locked"
msgstr "no se bloqueó el depósito del vendedor"

msgctxt "roblosats-admin"
msgid "the buyer's invoice was not submitted"
msgstr "el comprador no envió su factura"

msgctxt "roblosats-admin"
msgid "neither the escrow nor the invoice arrived"
msgstr "no llegaron ni el depósito ni la factura"

msgctxt "roblosats-admin"
msgid "Order %(id)s"
msgstr "Orden %(id)s"

msgctxt "roblosats-admin"
msgid "Coordinator panel"
msgstr "Panel del coordinador"

msgctxt "roblosats-admin"
msgid "ready to send"
msgstr "listo para enviar"

msgctxt "roblosats-admin"
msgid "not configured"
msgstr "sin configurar"

msgctxt "roblosats-admin"
msgid "The coordinator's bot writes to your chat when something happens to an order. Changes apply right away: no restart needed. If Telegram fails, the orders carry on as usual."
msgstr "El bot del coordinador te escribe cuando pasa algo en una orden. Los cambios se aplican al momento, sin reiniciar. Si Telegram falla, las órdenes siguen su curso igual."

msgctxt "roblosats-admin"
msgid "Bot and chat"
msgstr "Bot y chat"

msgctxt "roblosats-admin"
msgid "Bot token"
msgstr "Token del bot"

msgctxt "roblosats-admin"
msgid "saved"
msgstr "guardado"

msgctxt "roblosats-admin"
msgid "A token is saved"
msgstr "Hay un token guardado"

msgctxt "roblosats-admin"
msgid "Leave the field empty to keep it."
msgstr "Deja el campo vacío para conservarlo."

msgctxt "roblosats-admin"
msgid "Remove the saved token"
msgstr "Borrar el token guardado"

msgctxt "roblosats-admin"
msgid "None saved here: the TELEGRAM_TOKEN of the environment is used"
msgstr "No hay ninguno guardado aquí: se usa el TELEGRAM_TOKEN del entorno"

msgctxt "roblosats-admin"
msgid "Create a bot with @BotFather and paste its token. It stays on the server and is never shown again in full."
msgstr "Crea un bot con @BotFather y pega su token. Se queda en el servidor y no se vuelve a mostrar entero."

msgctxt "roblosats-admin"
msgid "Chat id"
msgstr "Id del chat"

msgctxt "roblosats-admin"
msgid "Your user id, a group id (starts with -) or a @channel where the bot can write. Send a message to the bot first, or add it to the group."
msgstr "Tu id de usuario, el id de un grupo (empieza por -) o un @canal donde el bot pueda escribir. Escribe antes al bot, o añádelo al grupo."

msgctxt "roblosats-admin"
msgid "Empty: the TELEGRAM_COORDINATOR_CHAT_ID of the environment is used"
msgstr "Vacío: se usa el TELEGRAM_COORDINATOR_CHAT_ID del entorno"

msgctxt "roblosats-admin"
msgid "Language of the alerts"
msgstr "Idioma de los avisos"

msgctxt "roblosats-admin"
msgid "Panel address for the links"
msgstr "Dirección del panel para los enlaces"

msgctxt "roblosats-admin"
msgid "Each alert links to the order's page in this panel. Empty: the coordinator's HOST_NAME is used"
msgstr "Cada aviso enlaza con la ficha de la orden en este panel. Vacío: se usa el HOST_NAME del coordinador"

msgctxt "roblosats-admin"
msgid "What to be told about"
msgstr "De qué quieres enterarte"

msgctxt "roblosats-admin"
msgid "Chat messages in a dispute are encrypted between the parties: the alert only says who wrote, at most once every few minutes per order. Cancellations do not include orders whose maker never locked the bond."
msgstr "Los mensajes del chat en una disputa van cifrados entre las partes: el aviso solo dice quién ha escrito, como mucho una vez cada pocos minutos por orden. Las cancelaciones no incluyen las órdenes cuyo creador nunca bloqueó la fianza."

