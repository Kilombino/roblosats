msgid "Save"
msgstr "Guardar"

msgctxt "roblosats-admin"
msgid "Try it"
msgstr "Probar"

msgctxt "roblosats-admin"
msgid "Sends a message with the saved settings. Save first if you changed something."
msgstr "Envía un mensaje con los ajustes guardados. Guarda antes si has cambiado algo."

msgctxt "roblosats-admin"
msgid "Send test message"
msgstr "Enviar mensaje de prueba"

