msgctxt "roblosats-admin"
msgid "The buyer %(buyer)s is credited %(total)s sats as a reward (their bond of %(buyer_bond)s + %(trade)s from the trade). They withdraw it from the app."
msgstr "O comprador %(buyer)s recebe um crédito de %(total)s sats como recompensa (a sua fiança de %(buyer_bond)s + %(trade)s da negociação). Levanta-os na app."

msgctxt "roblosats-admin"
msgid "The seller %(seller)s gets nothing back: they lose their bond (%(seller_bond)s) and their escrow (%(escrow)s)."
msgstr "O vendedor %(seller)s não recupera nada: perde a sua fiança (%(seller_bond)s) e o seu depósito (%(escrow)s)."

msgctxt "roblosats-admin"
msgid "The seller %(seller)s is credited %(total)s sats as a reward (their bond of %(seller_bond)s + their escrow of %(escrow)s). They withdraw it from the app."
msgstr "O vendedor %(seller)s recebe um crédito de %(total)s sats como recompensa (a sua fiança de %(seller_bond)s + o seu depósito de %(escrow)s). Levanta-os na app."

msgctxt "roblosats-admin"
msgid "The buyer %(buyer)s gets nothing and loses their bond (%(buyer_bond)s)."
msgstr "O comprador %(buyer)s não recebe nada e perde a sua fiança (%(buyer_bond)s)."

msgctxt "roblosats-admin"
msgid "The order ends as collaboratively cancelled."
msgstr "A ordem termina como cancelada por acordo mútuo."

msgctxt "roblosats-admin"
msgid "%(t)s left"
msgstr "faltam %(t)s"

msgctxt "roblosats-admin"
msgid "expired %(t)s ago"
msgstr "expirou há %(t)s"

msgctxt "roblosats-admin"
msgid "winner: %(role)s"
msgstr "vencedor: %(role)s"

msgctxt "roblosats-admin"
msgid "Choose who the message is for."
msgstr "Escolha para quem é a mensagem."

msgctxt "roblosats-admin"
msgid "The decision was not confirmed. Nothing was done."
msgstr "A decisão não foi confirmada. Não foi feito nada."

msgctxt "roblosats-admin"
msgid "The order changed status while you were confirming. Nothing was done: review it again."
msgstr "A ordem mudou de estado enquanto confirmava. Não foi feito nada: reveja-a novamente."

msgctxt "roblosats-admin"
msgid "deadline expired"
msgstr "prazo expirado"

msgctxt "roblosats-admin"
msgid "Each party gets back what they put in, credited as a reward to withdraw from the app: the buyer %(buyer)s their bond (%(buyer_bond)s); the seller %(seller)s their bond (%(seller_bond)s) and their escrow (%(escrow)s)."
msgstr "Cada parte recupera o que pôs, creditado como recompensa para levantar na app: o comprador %(buyer)s a sua fiança (%(buyer_bond)s); o vendedor %(seller)s a sua fiança (%(seller_bond)s) e o seu depósito (%(escrow)s)."

msgctxt "roblosats-admin"
msgid "The message is empty: nothing was sent."
msgstr "A mensagem está vazia: não foi enviado nada."

msgctxt "roblosats-admin"
msgid "It cannot be resolved this way right now: %(why)s. Nothing was done."
msgstr "Neste momento não é possível resolver assim: %(why)s. Não foi feito nada."

msgctxt "roblosats-admin"
msgid "Done: “%(decision)s” on order %(id)s. (%(detail)s)"
msgstr "Feito: «%(decision)s» na ordem %(id)s. (%(detail)s)"

msgctxt "roblosats-admin"
msgid "Order %(id)s could not be resolved. Response: %(detail)s"
msgstr "Não foi possível resolver a ordem %(id)s. Resposta: %(detail)s"

msgctxt "roblosats-admin"
msgid "The buyer's invoice has already expired: the payment will probably fail and you will have to ask them for a new one."
msgstr "A fatura do comprador já expirou: o pagamento provavelmente falhará e terá de lhe pedir uma nova."

msgctxt "roblosats-admin"
msgid "Both bonds are credited back as rewards: %(buyer_bond)s to the buyer and %(seller_bond)s to the seller %(seller)s."
msgstr "As duas fianças voltam como recompensa: %(buyer_bond)s para o comprador e %(seller_bond)s para o vendedor %(seller)s."

msgctxt "roblosats-admin"
msgid "The message has %(n)s characters; the limit is %(max)s. Nothing was sent."
msgstr "A mensagem tem %(n)s caracteres; o máximo é %(max)s. Não foi enviado nada."

msgctxt "roblosats-admin"
msgid "There is nobody to send it to."
msgstr "Não há ninguém a quem enviá-la."

msgctxt "roblosats-admin"
msgid "The buyer %(buyer)s is paid %(trade)s sats on-chain, to the address they gave."
msgstr "O comprador %(buyer)s recebe %(trade)s sats on-chain, no endereço que indicou."

msgctxt "roblosats-admin"
msgid "The buyer %(buyer)s is paid %(trade)s sats right now over Lightning, to the invoice they gave."
msgstr "O comprador %(buyer)s recebe já %(trade)s sats por Lightning, na fatura que indicou."

msgctxt "roblosats-admin"
msgid "Message sent to %(names)s (app, plus Nostr and Telegram if they use them)."
msgstr "Mensagem enviada a %(names)s (app, e Nostr e Telegram se os usarem)."

