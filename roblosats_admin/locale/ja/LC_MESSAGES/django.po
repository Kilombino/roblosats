msgstr "買い手 / 売り手"

msgctxt "roblosats-admin"
msgid "Outcome"
msgstr "結果"

msgctxt "roblosats-admin"
msgid "Created"
msgstr "作成日時"

msgctxt "roblosats-admin"
msgid "None yet."
msgstr "まだありません。"

