msgstr "コーディネーターからまだメッセージを送っていません。"

msgctxt "roblosats-admin"
msgid "Write to them"
msgstr "メッセージを書く"

msgctxt "roblosats-admin"
msgid "Prefix added to every message"
msgstr "各メッセージに付く接頭辞"

msgctxt "roblosats-admin"
msgid "Write to the buyer"
msgstr "買い手に書く"

msgctxt "roblosats-admin"
msgid "Write to the seller"
msgstr "売り手に書く"

msgctxt "roblosats-admin"
msgid "Write to both"
msgstr "両方に書く"

msgctxt "roblosats-admin"
msgid "Resolve the dispute"
msgstr "紛争を解決する"

msgctxt "roblosats-admin"
msgid "Are you sure?"
msgstr "本当によろしいですか？"

msgctxt "roblosats-admin"
msgid "This cannot be undone."
msgstr "この操作は取り消せません。"

msgctxt "roblosats-admin"
msgid "Yes, resolve it this way"
msgstr "はい、この内容で解決する"

msgctxt "roblosats-admin"
msgid "Cancel"
