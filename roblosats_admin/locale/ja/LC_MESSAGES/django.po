msgstr "ロックされた資金"

msgctxt "roblosats-admin"
msgid "Item"
msgstr "項目"

msgctxt "roblosats-admin"
msgid "Sats"
msgstr "sats"

msgctxt "roblosats-admin"
msgid "Status"
msgstr "ステータス"

msgctxt "roblosats-admin"
msgid "Expires"
msgstr "期限"

msgctxt "roblosats-admin"
msgid "Buyer's bond"
msgstr "買い手の保証金"

msgctxt "roblosats-admin"
msgid "Seller's bond"
msgstr "売り手の保証金"

msgctxt "roblosats-admin"
msgid "Seller's escrow"
msgstr "売り手のエスクロー"

msgctxt "roblosats-admin"
msgid "Buyer's payout invoice"
msgstr "買い手の受取用インボイス"

msgctxt "roblosats-admin"
