msgctxt "roblosats-admin"
msgid "The buyer %(buyer)s is credited %(total)s sats as a reward (their bond of %(buyer_bond)s + %(trade)s from the trade). They withdraw it from the app."
msgstr "Al comprador %(buyer)s se li abonen %(total)s sats com a recompensa (la seva fiança de %(buyer_bond)s + %(trade)s de l'operació). Els retira ell des de l'app."

msgctxt "roblosats-admin"
msgid "The seller %(seller)s gets nothing back: they lose their bond (%(seller_bond)s) and their escrow (%(escrow)s)."
msgstr "El venedor %(seller)s no recupera res: perd la seva fiança (%(seller_bond)s) i el seu dipòsit (%(escrow)s)."

msgctxt "roblosats-admin"
msgid "The seller %(seller)s is credited %(total)s sats as a reward (their bond of %(seller_bond)s + their escrow of %(escrow)s). They withdraw it from the app."
msgstr "Al venedor %(seller)s se li abonen %(total)s sats com a recompensa (la seva fiança de %(seller_bond)s + el seu dipòsit de %(escrow)s). Els retira ell des de l'app."

msgctxt "roblosats-admin"
msgid "The buyer %(buyer)s gets nothing and loses their bond (%(buyer_bond)s)."
msgstr "El comprador %(buyer)s no rep res i perd la seva fiança (%(buyer_bond)s)."

msgctxt "roblosats-admin"
msgid "The order ends as collaboratively cancelled."
msgstr "L'ordre queda com a cancel·lada de mutu acord."

msgctxt "roblosats-admin"
msgid "%(t)s left"
msgstr "queden %(t)s"

