msgstr "ha guanyat: %(role)s"

msgctxt "roblosats-admin"
msgid "Choose who the message is for."
msgstr "Tria a qui va el missatge."

msgctxt "roblosats-admin"
msgid "The decision was not confirmed. Nothing was done."
msgstr "La decisió no s'ha confirmat. No s'ha fet res."

msgctxt "roblosats-admin"
msgid "The order changed status while you were confirming. Nothing was done: review it again."
msgstr "L'ordre ha canviat d'estat mentre confirmaves. No s'ha fet res: revisa-la una altra vegada."

msgctxt "roblosats-admin"
msgid "deadline expired"
msgstr "termini vençut"

msgctxt "roblosats-admin"
msgid "Each party gets back what they put in, credited as a reward to withdraw from the app: the buyer %(buyer)s their bond (%(buyer_bond)s); the seller %(seller)s their bond (%(seller_bond)s) and their escrow (%(escrow)s)."
msgstr "Cada part recupera el que hi va posar, abonat com a recompensa per retirar des de l'app: el comprador %(buyer)s la seva fiança (%(buyer_bond)s); el venedor %(seller)s la seva fiança (%(seller_bond)s) i el seu dipòsit (%(escrow)s)."

msgctxt "roblosats-admin"
msgid "The message is empty: nothing was sent."
msgstr "El missatge és buit: no s'ha enviat res."

msgctxt "roblosats-admin"
msgid "It cannot be resolved this way right now: %(why)s. Nothing was done."
msgstr "Ara mateix no es pot resoldre així: %(why)s. No s'ha fet res."

msgctxt "roblosats-admin"
msgid "Done: “%(decision)s” on order %(id)s. (%(detail)s)"
msgstr "Fet: «%(decision)s» a l'ordre %(id)s. (%(detail)s)"

msgctxt "roblosats-admin"
msgid "Order %(id)s could not be resolved. Response: %(detail)s"
msgstr "No s'ha pogut resoldre l'ordre %(id)s. Resposta: %(detail)s"

msgctxt "roblosats-admin"
msgid "The buyer's invoice has already expired: the payment will probably fail and you will have to ask them for a new one."
msgstr "La factura del comprador ja ha caducat: és probable que el pagament falli i calgui demanar-li'n una de nova."

msgctxt "roblosats-admin"
msgid "Both bonds are credited back as rewards: %(buyer_bond)s to the buyer and %(seller_bond)s to the seller %(seller)s."
msgstr "Les dues fiances tornen com a recompensa: %(buyer_bond)s al comprador i %(seller_bond)s al venedor %(seller)s."

msgctxt "roblosats-admin"
msgid "The message has %(n)s characters; the limit is %(max)s. Nothing was sent."
msgstr "El missatge té %(n)s caràcters; el màxim és %(max)s. No s'ha enviat res."

msgctxt "roblosats-admin"
msgid "There is nobody to send it to."
msgstr "No hi ha ningú a qui enviar-lo."

msgctxt "roblosats-admin"
msgid "The buyer %(buyer)s is paid %(trade)s sats on-chain, to the address they gave."
msgstr "Es paguen al comprador %(buyer)s %(trade)s sats on-chain, a l'adreça que va donar."

msgctxt "roblosats-admin"
msgid "The buyer %(buyer)s is paid %(trade)s sats right now over Lightning, to the invoice they gave."
msgstr "Es paguen ara mateix al comprador %(buyer)s %(trade)s sats per Lightning, a la factura que va donar."

msgctxt "roblosats-admin"
msgid "Message sent to %(names)s (app, plus Nostr and Telegram if they use them)."
msgstr "Missatge enviat a %(names)s (app, i Nostr i Telegram si els fan servir)."

